-- ====== Draggable MainFrame ======
local dragging = false
local dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then update(input) end
end)

-- ====== دالة إنشاء أزرار 2x2 مركزية مع تبديل الحالة ======
local function createGridButtons(parent, buttons)
    local startX = -105
    local startY = 80
    local spacingX = 210
    local spacingY = 70

    for i,btnData in ipairs(buttons) do
        local col = (i-1)%2
        local row = math.floor((i-1)/2)
        local posX = startX + col*spacingX
        local posY = startY + row*spacingY

        local text = btnData[1]
        local code = btnData[2]
        local toggle = btnData[3]

        local btn = Instance.new("TextButton")
        btn.Parent = parent
        btn.Size = UDim2.new(0,200,0,50)
        btn.Position = UDim2.new(0.5,posX,0,posY)
        btn.AnchorPoint = Vector2.new(0.5,0)
        btn.Text = text
        btn.BackgroundColor3 = Color3.fromRGB(220,0,0)
        btn.TextColor3 = Color3.fromRGB(255,255,255)
        btn.Font = Enum.Font.SourceSansBold
        btn.TextSize = 18
        btn.AutoButtonColor = true

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 3
        stroke.Color = Color3.fromRGB(0,0,0)
        stroke.Parent = btn

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0,5)
        corner.Parent = btn

        if toggle then
            btn.MouseButton1Click:Connect(function()
                if btn.Text:find("مُتوقف") then
                    btn.Text = btn.Text:gsub("مُتوقف","مُفعل")
                else
                    btn.Text = btn.Text:gsub("مُفعل","مُتوقف")
                end
                local codePlaceholder = code
            end)
        else
            btn.MouseButton1Click:Connect(function()
                local codePlaceholder = code
            end)
        end
    end
end

